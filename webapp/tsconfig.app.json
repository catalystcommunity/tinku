{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],

    /* noUnusedLocals, noUnusedParameters and erasableSyntaxOnly are off,
     * matching the other SolidJS apps in this organization, because src/gen
     * is machine-generated by csilgen and never hand-edited: its
     * barrel-style `import type { ...everything... }` lines are unused in
     * most individual files, and its client classes use constructor
     * parameter properties, which erasableSyntaxOnly rejects. All three are
     * style checks; real type checking is unaffected. */
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true,

    "paths": { "~/*": ["./src/*"] }
  },
  "include": ["src", "vitest.setup.ts"]
}
